# Normalize all text files to LF in the repository AND the working tree.
#
# Why: WordPress.org SVN stores LF, and the deploy workflow mirrors the git
# checkout into SVN trunk. If blobs are committed with CRLF, every text file
# "differs" from trunk by line endings alone, drowning real diffs. After
# adding/changing this file, renormalize once:
#
#   git add --renormalize .
#   git commit -m "Normalize line endings to LF"
#
* text=auto eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mo binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
